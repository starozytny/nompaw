{% extends 'layout/layout_admin.html.twig' %}

{% set page_prefix = "Administrateur" %}

{% set menu = [
    {
        name: "Dashboard", icon: "home",
        path: path('admin_homepage'),
        matchRoute: ['admin_homepage']
    },
    {
        name: "Sociétés", icon: "bank",
        path: path('admin_societies_index'),
        matchRoute: ['admin_societies_index', 'admin_societies_create', 'admin_societies_update', 'admin_societies_read']
    },
    {
        name: "Utilisateurs", icon: "group",
        path: path('admin_users_index'),
        matchRoute: ['admin_users_index', 'admin_users_create', 'admin_users_update', 'admin_users_read', 'admin_users_password']
    },
    {
        name: "Contacts", icon: "chat",
        path: path('admin_contacts_index'),
        matchRoute: ['admin_contacts_index']
    },
    {
        name: "Stockage", icon: "box",
        path: path('admin_storage_index'),
        matchRoute: ['admin_storage_index',]
    },
    {
        name: "Accès photos famille", icon: "camera",
        path: path('admin_photos_access_index'),
        matchRoute: ['admin_photos_access_index',]
    }
] %}

{% set menu_bottom = [
    {
        name: "Espace utilisateur", icon: "earth",
        path: path('user_homepage'),
        matchRoute: ['user_homepage']
    },
    {
        name: "Page accueil", icon: "earth",
        path: path('app_homepage'),
        matchRoute: ['app_homepage']
    },
] %}

{% block footer %}
    <div class="relative z-10 bg-sidebar px-4 py-8 text-sm sm:px-6 lg:px-8">
        <div class="mx-auto max-w-screen-2xl flex flex-col text-center sm:flex-row sm:text-left gap-2 justify-center">
            <p class="text-slate-100">&copy; 2024 - <a href="https://chanbora-chhun.fr" class="text-blue-400">Chanbora Chhun</a></p>
            <span class="text-slate-100">-</span>
            <a class="text-gray-100 hover:text-gray-300 hover:underline" href="{{ path('app_mentions') }}">Mentions légales</a>
            <a class="text-gray-100 hover:text-gray-300 hover:underline" href="{{ path('app_politique') }}">Politique de confidentialité</a>
            <a class="text-gray-100 hover:text-gray-300 hover:underline" href="{{ path('app_cookies') }}">Gestion des cookies</a>
            <a class="text-gray-100 hover:text-gray-300 hover:underline" href="{{ path('user_homepage') }}">Espace utilisateur</a>
        </div>
    </div>
{% endblock %}
