{% extends 'app/pages/security/template.html.twig' %}

{% set page_title %}Rejoindre la communauté{% endset %}

{% block main_content %}
    <div class="min-h-full max-w-screen-lg mx-auto sm:my-8">
        <div class="flex flex-col justify-center bg-card text-card-foreground border border-border p-4 rounded-xl shadow-xl px-6 py-12 lg:px-8">
            <div class="sm:mx-auto sm:w-full sm:max-w-screen-lg">
                <h1 class="text-center text-3xl sm:text-4xl font-bold leading-9 tracking-tight">Rejoindre la communauté 🔒</h1>
                <p class="text-muted-foreground text-center text-sm mt-1">Vos données ne sont utilisées que pour nompaw.fr, elles servent à vous authentifier et vous démarquez des autres utilisateurs.</p>
            </div>

            <div class="mt-6 sm:mx-auto sm:w-full sm:max-w-screen-sm">
                <div id="registration">
                    {% include "layout/components/tailwind/loaders/loader.html.twig" %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
