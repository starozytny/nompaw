{% extends 'base_tailwind.html.twig' %}

{% set html_class = "theme-admin" %}

{% block title %}{{ page_title }} | {{ page_prefix }} {% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('admin_app') }}
{% endblock %}

{% block body %}
    {% include "layout/components/page-loader.html.twig" %}

    <div id="app-shell"
         data-menu="{{ menu|json_encode }}"
         data-menu-secondary="{{ menu_bottom|json_encode }}"
         data-user="{{ { name: app.user.displayName, email: app.user.email, avatar: app.user.avatarFile, initials: (app.user.lastname|slice(0,1)) ~ (app.user.firstname|slice(0,1)) }|json_encode }}"
         data-active-route="{{ app.request.get('_route') }}"
         data-page-title="{{ page_title|default('') }}"
         data-home-path="{{ path('admin_homepage') }}"
         data-logo-path="{{ asset('build/admin/images/logo.png') }}"
         data-profile-path="{{ path('user_profil_index') }}"
         data-logout-path="{{ path('app_logout') }}"
    >
        <div class="flex min-h-svh w-full bg-sidebar" aria-hidden="true">
            <div class="hidden w-64 shrink-0 flex-col gap-2 p-3 md:flex">
                <div class="h-12 rounded-md bg-sidebar-accent/80 animate-pulse"></div>
                <div class="mt-2 flex flex-1 flex-col gap-1.5">
                    {% for i in 1..9 %}
                        <div class="h-8 rounded-md bg-sidebar-accent/50 animate-pulse"></div>
                    {% endfor %}
                </div>
                <div class="h-11 rounded-md bg-sidebar-accent/80 animate-pulse"></div>
            </div>
            <div class="flex flex-1 flex-col bg-background md:m-2 md:ml-0 md:rounded-xl md:shadow">
                <div class="flex h-14 shrink-0 items-center gap-2 border-b px-4">
                    <div class="h-4 w-32 rounded bg-muted animate-pulse"></div>
                </div>
            </div>
        </div>
    </div>

    <div id="main-content-source" class="hidden bg-sidebar">
        <div class="relative isolate {{ maj_class }} items-center gap-x-6 overflow-hidden bg-gray-50 px-6 py-2.5 sm:px-3.5 sm:before:flex-1">
            <div class="absolute left-[max(-7rem,calc(50%-52rem))] top-1/2 -z-10 -translate-y-1/2 transform-gpu blur-2xl" aria-hidden="true">
                <div class="aspect-[577/310] w-[36.0625rem] bg-gradient-to-r from-[#ff80b5] to-[#9089fc] opacity-30"
                     style="clip-path: polygon(74.8% 41.9%, 97.2% 73.2%, 100% 34.9%, 92.5% 0.4%, 87.5% 0%, 75% 28.6%, 58.5% 54.6%, 50.1% 56.8%, 46.9% 44%, 48.3% 17.4%, 24.7% 53.9%, 0% 27.9%, 11.9% 74.2%, 24.9% 54.1%, 68.6% 100%, 74.8% 41.9%)"></div>
            </div>
            <div class="absolute left-[max(45rem,calc(50%+8rem))] top-1/2 -z-10 -translate-y-1/2 transform-gpu blur-2xl" aria-hidden="true">
                <div class="aspect-[577/310] w-[36.0625rem] bg-gradient-to-r from-[#ff80b5] to-[#9089fc] opacity-30"
                     style="clip-path: polygon(74.8% 41.9%, 97.2% 73.2%, 100% 34.9%, 92.5% 0.4%, 87.5% 0%, 75% 28.6%, 58.5% 54.6%, 50.1% 56.8%, 46.9% 44%, 48.3% 17.4%, 24.7% 53.9%, 0% 27.9%, 11.9% 74.2%, 24.9% 54.1%, 68.6% 100%, 74.8% 41.9%)"></div>
            </div>
            <div class="w-full flex flex-wrap items-center justify-center gap-x-4 gap-y-2">
                <p class="text-sm leading-6 text-gray-900">
                    <span class="font-semibold">{{ maj_date }}</span> {{ maj_text }}
                </p>
            </div>
        </div>

        {% include "layout/components/admin/page_title.html.twig" %}

        <div class="bg-gray-100 rounded-b-xl {{ div_class is defined ? div_class : "px-4 py-8 min-h-screen sm:px-6 lg:px-8" }}">
            {% block main_content %}{% endblock %}
        </div>

        <div id="app-footer" class="hidden">
            {% block footer %}{% endblock %}
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('admin_app') }}
{% endblock %}
