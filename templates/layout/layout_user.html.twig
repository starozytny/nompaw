{% extends 'base_tailwind.html.twig' %}

{% block title %}{{ page_title }} | {{ page_prefix }} {% endblock %}

{#{% set html_class = "bg-sidebar" %}#}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('user_app') }}
{% endblock %}

{% block body %}
    {% include "layout/components/page-loader.html.twig" %}

    <div id="app-shell"
         data-menu="{{ menu|json_encode }}"
         data-menu-secondary="{{ menu_bottom|json_encode }}"
         data-user="{{ { name: app.user.displayName, email: app.user.email, avatar: app.user.avatarFile, initials: (app.user.lastname|slice(0,1)) ~ (app.user.firstname|slice(0,1)) }|json_encode }}"
         data-active-route="{{ app.request.get('_route') }}"
         data-page-title="{{ page_title|default('') }}"
         data-home-path="{{ path('user_homepage') }}"
         data-logo-path="{{ asset('build/user/images/logo.png') }}"
         data-profile-path="{{ path('user_profil_index') }}"
         data-logout-path="{{ path('app_logout') }}"
    >
        <div class="flex min-h-svh w-full" aria-hidden="true">
            <div class="m-2 hidden w-64 shrink-0 flex-col gap-2 rounded-xl bg-sidebar p-2 md:flex">
                <div class="h-12 rounded-md bg-sidebar-accent/80 animate-pulse"></div>
                <div class="mt-2 flex flex-1 flex-col gap-1.5">
                    {% for i in 1..8 %}
                        <div class="h-8 rounded-md bg-sidebar-accent/50 animate-pulse"></div>
                    {% endfor %}
                </div>
                <div class="h-11 rounded-md bg-sidebar-accent/80 animate-pulse"></div>
            </div>
            <div class="flex flex-1 flex-col">
                <div class="flex h-14 shrink-0 items-center gap-2 border-b px-4">
                    <div class="h-4 w-32 rounded bg-muted animate-pulse"></div>
                </div>
            </div>
        </div>
    </div>

    <div id="main-content-source" class="hidden bg-red-400">
        {% include "layout/components/user/page_title.html.twig" %}

        <div class="bg-gray-100 {{ div_class is defined ? div_class : "mx-auto max-w-screen-qhd px-4 py-8 min-h-screen sm:px-6 lg:px-8" }}">
            {% block main_content %}{% endblock %}
        </div>

        <div id="app-footer" class="hidden">
            {% block footer %}{% endblock %}
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('user_app') }}
{% endblock %}
