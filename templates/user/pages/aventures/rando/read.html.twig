{% extends 'user/pages/aventures/template.html.twig' %}

{% set groupe = elem.groupe %}
{% set author = elem.author %}
{% set canManage = app.user.id == elem.author.id or app.user.isAdmin %}
{% set adventure = elem.adventure %}
{% set isCalee = elem.startAt and elem.adventure %}
{% set hasInfo = elem.description or elem.distance or elem.devPlus or elem.altitude or elem.localisation or elem.story or (adventure and adventure.url and adventure.url != "https://") %}

{% set page_title %}{{ elem.name }}{% endset %}
{% set page_subtitle %}Groupe d'aventures : {{ groupe.name }}{% endset %}

{% block breadcrumb %}
    {% set breadcrumbs = breadcrumbs | merge([
        { text: groupe.name, url: path('user_aventures_groupes_read', {'slug': groupe.slug}) },
        { text: page_title_alone, url: path('user_aventures_randos_read', {'slug': elem.slug}) },
    ]) %}
    {{ parent() }}
{% endblock %}

{% set page_actions %}
    <div class="flex flex-wrap items-center justify-end gap-2">
        {% include 'layout/components/tailwind/buttons/button.html.twig' with {
            btn_link: path('user_aventures_groupes_read', {slug: groupe.slug}),
            btn_type: 'default',
            btn_icon: 'left-arrow',
            btn_text: 'Retourner au groupe'
        } %}
        {% if canManage %}
            {% include 'layout/components/tailwind/buttons/button.html.twig' with {
                btn_link: path('user_aventures_randos_update', {slug: elem.slug}),
                btn_type: 'default',
                btn_icon: 'pencil',
                btn_text: 'Modifier'
            } %}

            {% if isCalee %}
                <div id="rando_date" data-variant="action"
                     data-rando-id="{{ elem.id }}"
                     data-start-at="{{ elem.startAt | date('Y-m-d') }}"
                     data-propals="{{ propalDates }}"
                     data-user-id="{{ app.user.id }}"
                     data-author-id="{{ elem.author.id }}"
                     data-mode="{{ canManage }}"
                     data-status="{{ elem.status }}"
                     data-date-id="{{ elem.adventureDate ? elem.adventureDate.id : '' }}"
                     data-adventure-id="{{ elem.adventure ? elem.adventure.id : '' }}"></div>
                <div id="rando_adventures" data-variant="action"
                     data-rando-id="{{ elem.id }}"
                     data-user-id="{{ app.user.id }}"
                     data-have-adventure="1"
                     data-adv-name="{{ elem.adventure.name }}"
                     data-propals="{{ propalAdvs }}"
                     data-author-id="{{ elem.author.id }}"
                     data-mode="{{ canManage }}"
                     data-status="{{ elem.status }}"></div>
            {% endif %}

            {% if elem.status != 2 and isCalee %}
                <div class="end-rando" data-context="read" data-id="{{ elem.id }}" data-name="{{ elem.name }}" data-groupe-slug="{{ groupe.slug }}">
                    {% include 'layout/components/tailwind/buttons/button.html.twig' with {
                        btn_link: "", btn_type: 'green', btn_icon: 'chart-3', btn_text: 'Terminer'
                    } %}
                </div>
            {% endif %}

            <div class="delete-rando" data-context="read" data-id="{{ elem.id }}" data-name="{{ elem.name }}" data-groupe-slug="{{ groupe.slug }}">
                {% include 'layout/components/tailwind/buttons/button.html.twig' with {
                    btn_link: "", btn_type: 'red', btn_icon: 'chart-3', btn_text: 'Supprimer'
                } %}
            </div>
        {% endif %}
    </div>
{% endset %}

{% block main_content %}
{# Carnet : texte et photo se partagent l'en-tête ; les chiffres deviennent une fiche technique. #}
{% set coverSrc = hd ? path('intern_api_aventures_images_file_hd_src', {id: hd.id}) : (elem.cover ? path('intern_api_aventures_randos_cover_src', {id: elem.id, v: elem.cover}) : asset(groupe.imageFile)) %}
{% set stats = [] %}
{% import 'layout/components/lucide.html.twig' as lucide %}
{% if elem.distance %}{% set stats = stats|merge([{label: 'Distance', icon: 'route', value: elem.distance|number_format(1, ',', ' ') ~ ' km'}]) %}{% endif %}
{% if elem.devPlus %}{% set stats = stats|merge([{label: 'D+', icon: 'trending-up', long: 'Dénivelé positif', value: elem.devPlus|number_format(0, ',', ' ') ~ ' m'}]) %}{% endif %}
{% if elem.altitude %}{% set stats = stats|merge([{label: 'Altitude', icon: 'mountain-snow', long: 'Altitude max', value: elem.altitude|number_format(0, ',', ' ') ~ ' m'}]) %}{% endif %}
{% if adventure and adventure.duration %}{% set stats = stats|merge([{label: 'Durée', icon: 'clock', value: adventure.duration|date('G\\hi')}]) %}{% endif %}
{% if photos %}{% set stats = stats|merge([{label: 'Photos', icon: 'images', value: photos}]) %}{% endif %}

<div class="flex flex-col gap-8">
    <section class="bg-white rounded-2xl shadow-sm p-6 sm:p-10 grid gap-10 lg:grid-cols-2 items-center">
        <div class="order-2 lg:order-1 flex flex-col gap-6">
            <div>
                <a href="{{ path('user_aventures_groupes_read', {slug: groupe.slug}) }}" class="text-xs uppercase tracking-[0.16em] text-blue-600 font-semibold hover:text-blue-700">{{ groupe.name }}</a>
                <h2 class="text-4xl sm:text-5xl font-bold text-gray-900 leading-[1.05] mt-2 [text-wrap:balance]">{{ elem.name }}</h2>
                <p class="text-gray-500 mt-3 flex flex-wrap items-center gap-x-4 gap-y-1">
                    <span class="inline-flex items-center gap-1.5">{{ lucide.icon('calendar', 'w-4 h-4 text-gray-400') }}{{ elem.startAt ? elem.startAt|format_datetime('full', 'none', locale='fr')|capitalize : 'Date à définir' }}</span>
                    {% if elem.localisation %}<span class="inline-flex items-center gap-1.5">{{ lucide.icon('map-pin', 'w-4 h-4 text-gray-400') }}{{ elem.localisation }}</span>{% endif %}
                </p>
            </div>

            {% if elem.description %}
                <div class="text-lg text-gray-700 leading-relaxed">{{ elem.description|raw }}</div>
            {% endif %}

            <dl class="text-sm border-y border-dashed border-gray-300 divide-y divide-dashed divide-gray-200">
                {% for s in stats|merge([{label: 'Statut', icon: 'flag', value: elem.statusString}]) %}
                    <div class="flex items-baseline gap-3 py-2.5">
                        <dt class="text-gray-500 inline-flex items-center gap-2 self-center">{{ lucide.icon(s.icon, 'w-4 h-4 text-gray-400') }}{{ s.long ?? s.label }}</dt>
                        <span class="flex-1 border-b border-dotted border-gray-300 translate-y-[-3px]" aria-hidden="true"></span>
                        <dd class="font-semibold text-gray-900 tabular-nums">{{ s.value }}</dd>
                    </div>
                {% endfor %}
            </dl>

            <div class="flex flex-wrap items-center justify-between gap-4">
                <div class="flex items-center gap-3">
                    {{ lucide.icon('users', 'w-4 h-4 text-gray-400') }}
                    <div class="flex -space-x-2">
                        {% for participant in participants|slice(0, 6) %}
                            <img src="{{ asset(participant.avatarFile) }}" alt="{{ participant.displayName }}" title="{{ participant.displayName }}" class="w-9 h-9 object-cover rounded-full border-2 border-white">
                        {% endfor %}
                        {% if participants|length > 6 %}
                            <span class="w-9 h-9 rounded-full border-2 border-white bg-slate-700 text-white text-xs font-medium flex items-center justify-center">+{{ participants|length - 6 }}</span>
                        {% endif %}
                    </div>
                    <span class="text-sm text-gray-500">Référent·e : <span class="font-medium text-gray-900">{{ author.displayName }}</span></span>
                </div>
                <div class="flex flex-wrap gap-2">
                    {% set linkClass = 'inline-flex items-center gap-1.5 rounded-full border border-gray-200 px-3 py-1.5 text-sm text-gray-700 hover:bg-gray-50 transition-colors duration-150' %}
                    {% if adventure and adventure.url and adventure.url != "https://" %}
                        <a href="{{ adventure.url }}" target="_blank" class="{{ linkClass }}">{{ lucide.icon('book-open', 'w-4 h-4 text-gray-500') }} Topo</a>
                    {% endif %}
                    {% if elem.story %}
                        <a href="{{ path('user_homepage') ~ 'blog/' ~ elem.story }}" target="_blank" class="{{ linkClass }}">{{ lucide.icon('scroll-text', 'w-4 h-4 text-gray-500') }} Lire l'histoire</a>
                    {% endif %}
                    {% if canManage %}
                        <a href="{{ path('user_aventures_randos_update', {slug: elem.slug}) }}" class="{{ linkClass }}">{{ lucide.icon('pencil', 'w-4 h-4 text-gray-500') }} {{ hasInfo ? 'Modifier les informations' : 'Ajouter des informations' }}</a>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="order-1 lg:order-2 relative px-2 sm:px-6 pb-6">
            <img src="{{ coverSrc }}" alt="{{ elem.name }}" class="w-full aspect-[4/5] object-cover rounded-xl shadow-lg rotate-[1.5deg]">
            {% if insetPhoto %}
                <img src="{{ path('intern_api_aventures_images_thumbs_src', {id: insetPhoto.id}) }}" alt="" loading="lazy"
                     class="hidden sm:block absolute bottom-0 left-0 w-2/5 aspect-square object-cover rounded-lg ring-8 ring-white shadow-xl rotate-[-4deg]">
            {% endif %}
        </div>
    </section>

    {% if not isCalee %}
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
                <div class="grid grid-cols-1 divide-y divide-slate-100 md:grid-cols-2 md:divide-y-0 md:divide-x">
                    <div class="p-5">
                        <div id="rando_date"
                             data-variant="cell"
                             data-rando-id="{{ elem.id }}"
                             data-start-at="{{ elem.startAt ? elem.startAt | date('Y-m-d') : '' }}"
                             data-propals="{{ propalDates }}"
                             data-user-id="{{ app.user.id }}"
                             data-author-id="{{ elem.author.id }}"
                             data-mode="{{ canManage }}"
                             data-status="{{ elem.status }}"
                             data-date-id="{{ elem.adventureDate ? elem.adventureDate.id : '' }}"
                             data-adventure-id="{{ elem.adventure ? elem.adventure.id : '' }}">
                            {% include "layout/components/tailwind/loaders/loader.html.twig" %}
                        </div>
                    </div>
                    <div class="p-5">
                        <div id="rando_adventures"
                             data-variant="cell"
                             data-rando-id="{{ elem.id }}"
                             data-user-id="{{ app.user.id }}"
                             data-have-adventure="{{ elem.adventure ? 1 : 0 }}"
                             data-adv-name="{{ elem.adventure ? elem.adventure.name : '' }}"
                             data-propals="{{ propalAdvs }}"
                             data-author-id="{{ elem.author.id }}"
                             data-mode="{{ canManage }}"
                             data-status="{{ elem.status }}">
                            {% include "layout/components/tailwind/loaders/loader.html.twig" %}
                        </div>
                    </div>
                </div>
    </div>
    {% endif %}
            {% if canManage %}
                <div id="rando_deposit"
                     data-rando-id="{{ elem.id }}"
                     data-enabled="{{ elem.depositEnabled ? 1 : 0 }}"
                     data-has-password="{{ elem.depositPassword ? 1 : 0 }}"
                     data-url="{{ elem.depositToken ? url('app_aventure_album', {token: elem.depositToken}) : '' }}"></div>
            {% endif %}

    <div id="rando_images"
         data-rando-id="{{ elem.id }}"
         data-rando-author="{{ elem.author.id }}"
         data-user-id="{{ app.user.id }}"
    >
        {% include "layout/components/tailwind/loaders/loader.html.twig" %}
    </div>


    <div class="drive-dropzone">
        <div>Déposez vos fichiers dans cette fenêtre.</div>
    </div>
</div>
{% endblock %}
