{% extends 'user/pages/aventures/template.html.twig' %}

{% set page_title %}Groupe d'aventures{% endset %}
{% set page_subtitle %}Liste des groupes d'aventures disponibles !{% endset %}

{% set page_actions %}
    {% include 'layout/components/tailwind/buttons/button.html.twig' with {
        btn_link: path('user_aventures_groupes_create'),
        btn_type: 'blue',
        btn_icon: 'add',
        btn_text: 'Ajouter un groupe'
    } %}
{% endset %}

{% block main_content %}
    {% import 'layout/components/lucide.html.twig' as lucide %}
    {# Same tooltip recipe as GroupeDelete.jsx (shadcn tooltip look, CSS-only, delayed on show). #}
    {% set tooltip = 'pointer-events-none absolute right-0 top-full z-10 mt-1.5 whitespace-nowrap rounded-md border bg-popover px-3 py-1.5 text-sm text-popover-foreground shadow-md opacity-0 scale-95 origin-top-right transition-[opacity,transform] duration-150 ease-out group-hover/tip:opacity-100 group-hover/tip:scale-100 group-hover/tip:delay-300 group-focus-within/tip:opacity-100 group-focus-within/tip:scale-100 motion-reduce:transition-none' %}
    {% if cards | length > 0 %}
        <div class="grid gap-6 grid-cols-1 lg:grid-cols-2">
            {% for c in cards %}
                <article class="relative overflow-hidden rounded-2xl bg-slate-800 group {{ loop.first ? 'lg:col-span-2 h-[460px]' : 'h-[380px]' }}">
                    <a href="{{ path('user_aventures_groupes_read', {slug: c.g.slug}) }}" class="absolute inset-0" aria-label="Voir le groupe {{ c.g.name }}">
                        <img src="{{ asset(c.g.imageFile) }}" alt="" loading="lazy"
                             class="w-full h-full object-cover transition-transform duration-300 ease-out [@media(hover:hover)]:group-hover:scale-[1.03] motion-reduce:transition-none">
                    </a>
                    {# Scrims: top for the badges/actions, a taller bottom one so the title and stats stay readable on bright photos. #}
                    <div class="pointer-events-none absolute inset-x-0 top-0 h-28 bg-gradient-to-b from-black/50 to-transparent"></div>
                    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-3/4 bg-gradient-to-t from-black/90 via-black/55 to-transparent"></div>

                    <div class="absolute top-4 left-4 right-4 flex items-start justify-between gap-3">
                        <div class="flex flex-wrap gap-2">
                            {% if c.next %}
                                <span class="bg-white/90 text-gray-900 text-xs font-medium px-3 py-1.5 rounded-full">
                                    Prochaine aventure · {{ c.next.startAt ? c.next.startAt|format_datetime(locale='fr', pattern='d MMMM') : 'en préparation' }}
                                </span>
                            {% endif %}
                            {% if not c.g.isVisible %}
                                <span class="bg-black/50 backdrop-blur-sm text-white text-xs px-3 py-1.5 rounded-full"><span class="icon-padlock"></span> Privé</span>
                            {% endif %}
                        </div>
                        {% if app.user.id == c.g.author.id %}
                            {# Shown on hover (pointer devices), always visible on touch, and when focused via keyboard. #}
                            <div class="flex gap-1.5 transition-opacity duration-150 ease-out motion-reduce:transition-none [@media(hover:hover)]:opacity-0 [@media(hover:hover)]:group-hover:opacity-100 [@media(hover:hover)]:focus-within:opacity-100">
                                <span class="relative inline-flex group/tip">
                                    <a href="{{ path('user_aventures_groupes_update', {slug: c.g.slug}) }}" aria-label="Modifier le groupe"
                                       class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-input bg-background text-foreground shadow-sm ring-offset-background transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2">
                                        {{ lucide.icon('pencil') }}
                                    </a>
                                    <span role="tooltip" class="{{ tooltip }}">Modifier</span>
                                </span>
                                <div class="delete-groupe" data-context="groupes" data-id="{{ c.g.id }}" data-name="{{ c.g.name }}"></div>
                            </div>
                        {% endif %}
                    </div>

                    <div class="absolute bottom-0 left-0 right-0 p-6 text-white flex flex-col gap-4 pointer-events-none">
                        <div>
                            <div class="text-xs uppercase tracking-[0.14em] text-white/70">
                                {{ c.count }} aventure{{ c.count > 1 ? 's' }}{% if c.since %} · depuis {{ c.since }}{% endif %}
                            </div>
                            <h3 class="{{ loop.first ? 'text-4xl' : 'text-3xl' }} font-bold mt-1 leading-tight [text-wrap:balance]">{{ c.g.name }}</h3>
                            <div class="text-sm text-white/80 mt-1">
                                {{ c.photos }} photos{% if c.km %} · {{ c.km }} km parcourus{% endif %} · {{ c.g.levelString }}
                            </div>
                        </div>

                        <div class="flex items-end justify-between gap-4">
                            {% if c.covers|length %}
                                {% set filmMax = loop.first ? 6 : 4 %}
                                <div class="flex gap-2 pointer-events-auto overflow-hidden">
                                    {% for r in c.covers|slice(0, filmMax) %}
                                        <a href="{{ path('user_aventures_randos_read', {slug: r.slug}) }}" title="{{ r.name }}"
                                           class="block w-16 h-12 flex-none overflow-hidden rounded-md ring-1 ring-white/30 transition-transform duration-150 ease-out [@media(hover:hover)]:hover:-translate-y-0.5 active:scale-[0.97] motion-reduce:transition-none">
                                            <img src="{{ path('intern_api_aventures_randos_cover_mini_src', {id: r.id, v: r.cover}) }}" alt="{{ r.name }}" loading="lazy" class="w-full h-full object-cover">
                                        </a>
                                    {% endfor %}
                                </div>
                            {% else %}
                                <span></span>
                            {% endif %}
                            <div class="pointer-events-auto"><div class="flex -space-x-2">
                                {% for member in c.g.links|slice(0, 4) %}
                                    {% include "user/layout/components/elements/avatar.html.twig" %}
                                {% endfor %}
                                {% if c.g.links|length > 4 %}
                                    <div class="w-8 h-8 rounded-full bg-slate-700 border-2 border-white flex items-center justify-center text-white text-xs font-medium">+{{ c.g.links|length - 4 }}</div>
                                {% endif %}
                            </div></div>
                        </div>
                    </div>
                </article>
            {% endfor %}
        </div>
    {% else %}
        <div class="w-full flex flex-col items-center justify-center">
            <div>
                <div class="flex flex-col items-center justify-center bg-white p-12 rounded-xl shadow-sm">
                    <div class="bg-blue-100 rounded-lg p-3">
                        <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/>
                        </svg>
                    </div>
                    <div class="text-xl font-medium mt-4">Aucune aventure enregistrée</div>
                    <div class="max-w-sm text-gray-500 text-center mt-2">
                        Vous n'avez aucune aventure de créée. Commencez avec votre premier groupe pour y ajouter des aventures.
                    </div>
                    <div class="mt-4">
                        {% include 'layout/components/tailwind/buttons/button.html.twig' with {
                            btn_link: path('user_aventures_groupes_create'),
                            btn_type: 'blue',
                            btn_icon: 'add',
                            btn_text: 'Créer un groupe'
                        } %}
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
{% endblock %}
