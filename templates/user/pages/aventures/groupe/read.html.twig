{% extends 'user/pages/aventures/template.html.twig' %}

{% set author = elem.author %}

{% set page_title %}{{ elem.name }}{% endset %}
{% set page_subtitle %}Groupe d'aventures : {{ elem.name }}{% endset %}

{% block breadcrumb %}
    {% set breadcrumbs = breadcrumbs | merge([
        { text: page_title_alone, url: path('user_aventures_groupes_read', {'slug': elem.slug})  },
    ]) %}
    {{ parent() }}
{% endblock %}

{% set page_actions %}
    {% include 'layout/components/tailwind/buttons/button.html.twig' with {
        btn_link: path('user_aventures_groupes_index'),
        btn_type: 'default',
        btn_icon: 'left-arrow',
        btn_text: 'Retourner aux groupes'
    } %}
    {% if app.user.id == elem.author.id or app.user.isAdmin %}
        {% include 'layout/components/tailwind/buttons/button.html.twig' with {
            btn_link: path('user_aventures_groupes_update', {slug: elem.slug}),
            btn_type: 'default',
            btn_icon: 'pencil',
            btn_text: 'Modifier'
        } %}
    {% endif %}
{% endset %}

{% block main_content %}
    <div class="flex flex-col gap-12">
        {# Prochaine aventure : la photo du groupe en panneau, la date posée dessus, le reste à côté. #}
        <section class="bg-white rounded-2xl shadow-sm overflow-hidden grid grid-cols-1 md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] max-w-6xl">
            <div class="relative min-h-56 bg-slate-800">
                <img src="{{ asset(elem.imageFile) }}" alt="" class="absolute inset-0 w-full h-full object-cover">
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-black/10"></div>
                <div class="absolute bottom-0 left-0 right-0 p-6 text-white">
                    <div class="text-xs uppercase tracking-[0.14em] text-white/75">Prochaine aventure</div>
                    {% if next and next.startAt %}
                        {% set daysTo = ((next.startAt|date('U')) - ('today'|date('U'))) // 86400 %}
                        <div class="text-4xl font-bold leading-tight mt-1">{{ next.startAt|format_datetime(locale='fr', pattern='d MMMM') }}</div>
                        <div class="text-sm text-white/85 mt-1">
                            {{ next.startAt|format_datetime(locale='fr', pattern='EEEE y')|capitalize }}
                            {% if daysTo > 1 %} · dans {{ daysTo }} jours{% elseif daysTo == 1 %} · demain{% elseif daysTo == 0 %} · aujourd'hui{% endif %}
                        </div>
                    {% else %}
                        <div class="text-3xl font-bold leading-tight mt-1">{{ next ? 'Date à définir' : 'Rien de prévu' }}</div>
                    {% endif %}
                </div>
            </div>

            <div class="p-6 flex flex-col gap-5">
                {% if next %}
                    {% set steps = ['Proposition', 'Validée', 'Terminée'] %}
                    <ol class="flex items-center gap-2 text-xs" aria-label="Statut de l'aventure">
                        {% for step in steps %}
                            {% set reached = loop.index0 <= next.status %}
                            <li class="flex items-center gap-2 {{ reached ? 'text-gray-900 font-medium' : 'text-gray-400' }}"{% if loop.index0 == next.status %} aria-current="step"{% endif %}>
                                <span class="w-2 h-2 rounded-full {{ loop.index0 == next.status ? 'bg-blue-600 ring-4 ring-blue-100' : (reached ? 'bg-blue-600' : 'bg-gray-300') }}"></span>
                                {{ step }}
                            </li>
                            {% if not loop.last %}<li aria-hidden="true" class="h-px w-6 {{ loop.index0 < next.status ? 'bg-blue-600' : 'bg-gray-200' }}"></li>{% endif %}
                        {% endfor %}
                    </ol>

                    <div>
                        <h2 class="text-2xl font-semibold text-gray-900">
                            <a href="{{ path('user_aventures_randos_read', {slug: next.slug}) }}" class="hover:underline underline-offset-4">{{ next.name }}</a>
                        </h2>
                        {% if next.description %}
                            <p class="text-sm text-gray-600 mt-2 line-clamp-3">{{ next.description|striptags }}</p>
                        {% endif %}
                    </div>

                    {% if next.adventure %}
                        <div class="flex flex-wrap gap-x-5 gap-y-2 text-sm text-gray-600">
                            <span><span class="icon-book-1 text-gray-400"></span> {{ next.adventure.name }}</span>
                            {% if next.adventure.duration %}<span><span class="icon-time text-gray-400"></span> {{ next.adventure.duration|date('H\\hi') }}</span>{% endif %}
                            {% if next.adventure.url and next.adventure.url != "https://" %}
                                <a href="{{ next.adventure.url }}" target="_blank" class="text-blue-600 hover:text-blue-700"><span class="icon-link"></span> Topo</a>
                            {% endif %}
                        </div>
                    {% endif %}
                {% else %}
                    <div>
                        <h2 class="text-2xl font-semibold text-gray-900">Aucune aventure de prévue</h2>
                        <p class="text-sm text-gray-600 mt-2">Proposez la prochaine sortie : dates et itinéraires se votent ensuite à plusieurs.</p>
                    </div>
                {% endif %}

                <div class="mt-auto flex flex-wrap items-end justify-between gap-4 pt-4 border-t border-gray-100">
                    <div class="flex flex-wrap gap-5 text-sm">
                        {% for ref in [{user: elem.author, role: 'Référent·e du groupe'}]|merge(next ? [{user: next.author, role: "Référent·e de l'aventure"}] : []) %}
                            <div class="flex items-center gap-2">
                                {% set member = {user: ref.user} %}
                                {% include "user/layout/components/elements/avatar.html.twig" %}
                                <div class="leading-tight">
                                    <div class="font-medium text-gray-900">{{ ref.user.displayName }}</div>
                                    <div class="text-xs text-gray-500">{{ ref.role }}</div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>

                    <div class="flex items-center gap-1">
                        {% if next %}
                            {% include 'layout/components/tailwind/buttons/button_icon.html.twig' with {
                                btn_link: path('user_aventures_randos_update', {slug: next.slug}),
                                btn_type: 'transparent',
                                btn_icon: 'pencil',
                                btn_text: 'Modifier'
                            } %}
                            <div class="delete-rando"
                                 data-context="randos"
                                 data-id="{{ next.id }}"
                                 data-name="{{ next.name }}"
                                 data-groupe-slug="{{ elem.slug }}"
                            >
                                {% include 'layout/components/tailwind/buttons/button_icon.html.twig' with {
                                    btn_link: "",
                                    btn_type: 'transparent',
                                    btn_icon: 'chart-3',
                                    btn_text: 'Supprimer'
                                } %}
                            </div>
                            <span class="ml-2">
                                {% include 'layout/components/tailwind/buttons/button.html.twig' with {
                                    btn_link: path('user_aventures_randos_read', {slug: next.slug}),
                                    btn_type: 'blue',
                                    btn_icon: 'right-arrow',
                                    btn_text: "Voir l'aventure"
                                } %}
                            </span>
                        {% else %}
                            {% include 'layout/components/tailwind/buttons/button.html.twig' with {
                                btn_link: path('user_aventures_randos_create', {g_slug: elem.slug}),
                                btn_type: 'blue',
                                btn_icon: 'add',
                                btn_text: 'Créer une aventure'
                            } %}
                        {% endif %}
                    </div>
                </div>
            </div>
        </section>

        <section>
            <h2 class="text-2xl font-semibold mb-6">Anciennes aventures</h2>
            {% if albums|length > 0 %}
                <div class="grid gap-8 grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4">
                    {% for a in albums %}
                        {% set cover = a.hd ? path('intern_api_aventures_images_file_hd_src', {id: a.hd.id}) : path('intern_api_aventures_randos_cover_src', {id: a.r.id}) %}
                        <article class="bg-white rounded-xl p-2 shadow-[5px_5px_0_-1px_#fff,5px_5px_0_0_rgb(0_0_0/0.08),10px_10px_0_-1px_#fff,10px_10px_0_0_rgb(0_0_0/0.06),0_2px_8px_rgb(0_0_0/0.08)]">
                            <a href="{{ path('user_aventures_randos_read', {slug: a.r.slug}) }}" class="group relative block overflow-hidden rounded-lg aspect-[4/3] bg-slate-200 active:scale-[0.99] transition-transform duration-150 ease-out motion-reduce:transition-none">
                                <img src="{{ cover }}" alt="{{ a.r.name }}" loading="lazy"
                                     class="w-full h-full object-cover transition-transform duration-300 ease-out [@media(hover:hover)]:group-hover:scale-[1.03] motion-reduce:transition-none">
                                <span class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/10 to-transparent"></span>
                                <span class="absolute bottom-0 left-0 right-0 p-4 text-white">
                                    <span class="block text-xs uppercase tracking-[0.12em] text-white/75">{{ a.r.startAt ? a.r.startAt|format_datetime(locale='fr', pattern='MMMM y') : 'Date inconnue' }}</span>
                                    <span class="block text-xl font-semibold leading-tight mt-0.5 line-clamp-2">{{ a.r.name }}</span>
                                </span>
                            </a>

                            {% if a.peeks|length %}
                                <div class="grid grid-cols-4 gap-1 mt-1">
                                    {% for img in a.peeks %}
                                        <a href="{{ path('user_aventures_randos_read', {slug: a.r.slug}) }}" class="relative block aspect-square overflow-hidden rounded bg-slate-200" tabindex="-1" aria-hidden="true">
                                            <img src="{{ path('intern_api_aventures_images_thumbs_src', {id: img.id}) }}" alt="" loading="lazy" class="w-full h-full object-cover">
                                            {% if loop.last and a.photos > a.peeks|length %}
                                                <span class="absolute inset-0 bg-black/50 flex items-center justify-center text-white text-sm font-semibold">+{{ a.photos - a.peeks|length }}</span>
                                            {% endif %}
                                        </a>
                                    {% endfor %}
                                </div>
                            {% endif %}

                            <div class="px-2 pt-3 pb-1 flex items-center justify-between gap-3 text-sm">
                                <span class="text-gray-500 truncate">{%- set parts = [] -%}{%- if a.r.localisation %}{% set parts = parts|merge([a.r.localisation]) %}{% endif -%}{%- if a.r.distance %}{% set parts = parts|merge([a.r.distance|round(1) ~ ' km']) %}{% endif -%}{%- if a.r.devPlus %}{% set parts = parts|merge([a.r.devPlus ~ ' m D+']) %}{% endif -%}{{ parts|join(' · ') }}</span>
                                {% if a.r.story %}
                                    <a href="{{ path('user_homepage') ~ 'blog/' ~ a.r.story }}" class="flex-none font-medium text-blue-600 hover:text-blue-700">Histoire →</a>
                                {% endif %}
                            </div>
                        </article>
                    {% endfor %}
                </div>
            {% else %}
                <div class="max-w-md flex flex-col items-center justify-center bg-white p-12 rounded-xl shadow-sm text-center">
                    <div class="bg-blue-100 rounded-lg p-3"><span class="icon-camera text-blue-600 text-xl"></span></div>
                    <div class="text-xl font-medium mt-4">Aucun souvenir pour l'instant</div>
                    <div class="text-gray-500 mt-2">Les albums apparaîtront ici après votre première aventure.</div>
                </div>
            {% endif %}
        </section>
    </div>
{% endblock %}
