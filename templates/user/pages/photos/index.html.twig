{% extends is_granted('ROLE_USER') ? 'user/pages/photos/template.html.twig' : 'user/pages/photos/template_guest.html.twig' %}

{% set page_title %}Photos{% endset %}
{% set page_subtitle %}Les photos et vidéos partagées par la famille.{% endset %}

{% block main_content %}
