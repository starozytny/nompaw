{% extends 'user/layout/layout.html.twig' %}

{% set page_title %}Tableau de bord{% endset %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('user_dashboard') }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('user_dashboard') }}
{% endblock %}

{% block main_content %}
    <div
        id="dashboard"
        data-paths="{{ {
            aventures: path('user_aventures_groupes_index'),
            budget: path('user_budget_index', {'year': 'now'|date('Y')}),
            videotheque: path('user_videotheque_index'),
            projets: path('user_projects_index'),
            anniversaires: path('user_birthdays_index'),
            cryptos: path('user_cryptos_index'),
            running: is_granted('ROLE_RUNNING') ? path('user_running_index') : null,
            invest: is_granted('ROLE_INVEST') ? path('user_invest_index') : null,
            photos: is_granted('ROLE_FAMILY_PHOTOS') ? path('user_photos_index') : null,
        } | json_encode }}"
    >
        {% include "layout/components/tailwind/loaders/loader.html.twig" %}
    </div>
{% endblock %}
