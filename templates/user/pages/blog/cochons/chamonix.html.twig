{% extends 'user/pages/blog/template.html.twig' %}

{% set page_title %}Les aventures des cochons{% endset %}
{% set page_subtitle %}Groupe d'aventures : Cochons{% endset %}

{% block main_content %}
    {% import 'user/pages/blog/_macros.html.twig' as b %}
    {% set groupe = "cochons" %}
    {% set aventure = "chamonix" %}

    {# Chaque lieu n'est défini qu'une fois ici : les data-lat/data-lng des sections
       et le tracé de la carte (map_path) en dérivent tous les deux. #}
    {% set places = {
        chalet: {lat: 45.9237, lng: 6.8694},
        houches: {lat: 45.8934, lng: 6.7970},
        annecy: {lat: 45.8992, lng: 6.1294},
        aiguille: {lat: 45.8792, lng: 6.8872},
        brevent: {lat: 45.9321, lng: 6.8306},
        merdeglace: {lat: 45.9264, lng: 6.9206},
    } %}
    {% set path_order = ['chalet', 'houches', 'annecy', 'aiguille', 'brevent', 'merdeglace', 'chalet'] %}
    {% set map_path = [] %}
    {% for key in path_order %}
        {% set map_path = map_path|merge([[places[key].lat, places[key].lng]]) %}
    {% endfor %}

    <div class="main-content main-content-transparent">
        <div class="max-w-6xl mx-auto px-4 py-8">
            <div class="grid lg:grid-cols-3 gap-8">

                <!-- Contenu principal -->
                <article class="max-w-2xl lg:col-span-2">
                    <header class="mb-8">
                        <h2 class="text-4xl font-bold text-gray-900 mb-4">
                            <span>Une escapade de 5 jours à Chamonix</span>
                        </h2>
                        <div class="flex flex-wrap items-center gap-3 text-sm text-gray-600">
                            <span>📍 Chamonix, France</span>
                            <span>•</span>
                            <span>👥 Groupe de 5 personnes</span>
                            <span>•</span>
                            <span>📅 1 au 4 Août 2024</span>
                        </div>
                    </header>

                    <!-- Jour 1 -->
                    <section class="mb-8" data-section="arrivee" data-lat="{{ places.chalet.lat }}" data-lng="{{ places.chalet.lng }}">
                        {{ b.day_header('Jour 1', 'Arrivée au chalet') }}

                        <p class="text-gray-700 leading-relaxed mb-6">
                            On démarre au petit matin pour se rendre à Chamonix, plus précisément aux alentours des
                            Bossons, pour rejoindre notre fabuleux chalet loué sur AirBnb.
                            <br>
                            Arrivé un peu avant midi, on dépose nos bagages, on choisit nos lits et on découvre les lieux !
                        </p>

                        {# Mise en page unique (2 photos empilées + vidéo côte à côte) : pas de macro, écrit à la main. #}
                        <figure class="mb-6">
                            <div class="flex gap-3 mb-3">
                                <div class="w-full">
                                    <div class="flex flex-col gap-3">
                                        {{ b.media({file: 'img-1v-2.jpg'}, groupe, aventure) }}
                                        {{ b.media({file: 'img-2v-2.jpg'}, groupe, aventure) }}
                                    </div>
                                </div>
                                <figure class="w-full">
                                    <div class="video-container h-full">
                                        <video controls>
                                            <source src="{{ path('intern_api_storytelling_images_file_src', {groupe: groupe, aventure: aventure, filename: 'v6.mp4'}) }}" type="video/mp4" />
                                        </video>
                                    </div>
                                </figure>
                            </div>
                            <figcaption class="text-sm text-gray-600 italic">
                                Chalet chaleureux, bien équipé et une magnifique vue sur le glacier des Bossons.
                            </figcaption>
                        </figure>
                    </section>

                    <!-- Les Houches -->
                    <section class="mb-8" data-section="houches" data-lat="{{ places.houches.lat }}" data-lng="{{ places.houches.lng }}">
                        {{ b.day_header('Houches', 'Petit repas avec vue') }}

                        <p class="text-gray-700 leading-relaxed mb-4">
                            Pour notre premier repas, on s'est dirigé aux Houches pour trouver une boulangerie.
                        </p>
                        <p class="text-gray-700 leading-relaxed mb-6">
                            On a fini par trouver, tant bien que mal, une boulangerie au pied d'un télésiège qui donne une superbe vue
                            sur les montagnes encore enneigées.
                        </p>

                        {# Deux groupes de médias sous une même légende : pas de macro, écrit à la main. #}
                        <figure class="mb-6">
                            <div class="grid grid-cols-2 gap-3 mb-3">
                                {{ b.media({file: 'img-4v-2.jpg'}, groupe, aventure) }}
                                {{ b.media({file: 'img-5v-2.jpg'}, groupe, aventure) }}
                                {{ b.media({file: 'img-6v-2.jpg'}, groupe, aventure) }}
                                {{ b.media({file: 'img-7v-2.jpg'}, groupe, aventure) }}
                            </div>
                            <div class="flex flex-col gap-3 mb-3">
                                {{ b.media({file: 'img-3v-2.jpg'}, groupe, aventure) }}
                                {{ b.media({file: 'v2.mp4', video: true}, groupe, aventure) }}
                            </div>
                            <figcaption class="text-sm text-gray-600 italic">
                                Vue depuis la terrasse sur les monts enneigés.
                            </figcaption>
                        </figure>

                        <p class="text-gray-700 leading-relaxed mb-6">
                            Première bière de l'escapade, on chill en terrasse avant de reprendre la voiture pour
                            se diriger à Annecy qui se trouve à environ 1h15 de route.
                        </p>

                        {{ b.gallery([{file: 'img-8v-2.jpg', aspect: true}], groupe, aventure, 1) }}
                    </section>

                    <!-- Annecy -->
                    <section class="mb-8" data-section="annecy" data-lat="{{ places.annecy.lat }}" data-lng="{{ places.annecy.lng }}">
                        {{ b.day_header('Annecy', 'Visite sous un temps pluvieux') }}

                        <p class="text-gray-700 leading-relaxed mb-6">
                            Pas de chance, on arrive à Annecy sous quelques fines averses.
                        </p>

                        {{ b.gallery([
                            {file: 'img-9v-2.jpg'},
                            {file: 'img-10v-2.jpg'},
                        ], groupe, aventure, 1, "Le fameux pont des amours.") }}

                        <p class="text-gray-700 leading-relaxed mb-6">
                            Le vieux Annecy est ce qu'il y a de plus intéressant à photographier. Son architecture et
                            ses décorations fleuries donnent un petit charme au lieu.
                        </p>

                        {{ b.gallery([
                            {file: 'img-11v-2.jpg'},
                            {file: 'img-12v-2.jpg'},
                            {file: 'img-13v-2.jpg'},
                            {file: 'img-14v-2.jpg'},
                        ], groupe, aventure, 2, "La ville d'Annecy.") }}

                        {{ b.gallery([
                            {file: 'img-15v-2.jpg'},
                            {file: 'img-16v-2.jpg'},
                        ], groupe, aventure, 1, "Shooting groupé") }}

                        <p class="text-gray-700 leading-relaxed mb-6">
                            Pour le soir, on a réservé un restaurant de burger qui proposait de belles choses bien grasses !
                        </p>

                        {# img-19v-2 porte un data-pos utilisé par l'ancien système de carte canvas (inutilisé
                           aujourd'hui) : bloc laissé à la main pour ne pas alourdir la macro pour un cas mort. #}
                        <figure class="mb-6">
                            <div class="grid grid-cols-2 gap-3 mb-3">
                                {{ b.media({file: 'img-17v-2.jpg'}, groupe, aventure) }}
                                {{ b.media({file: 'img-18v-2.jpg'}, groupe, aventure) }}
                            </div>
                            <div class="bg-gray-200 rounded-lg overflow-hidden">
                                <div class="w-full h-full flex items-center justify-center text-gray-400 text-sm">
                                    <img class="js-image" data-pos="0.6" src="{{ path('intern_api_storytelling_images_file_src', {groupe: groupe, aventure: aventure, filename: 'img-19v-2.jpg'}) }}"
                                         data-full-src="{{ path('intern_api_storytelling_images_file_hd_src', {groupe: groupe, aventure: aventure, filename: 'img-19v-2.jpg'}) }}" />
                                </div>
                            </div>
                            <figcaption class="text-sm text-gray-600 italic">
                                Le petit groupe avant d'aller graille
                            </figcaption>
                        </figure>

                        <p class="text-gray-700 leading-relaxed">
                            On finit la soirée en retournant à notre chalet pour jouer à quelques jeux de sociétés et
                            se reposer pour la vraie découverte de Chamonix.
                        </p>
                    </section>

                    <!-- Jour 2 -->
                    <section class="mb-8" data-section="jour2" data-lat="{{ places.chalet.lat }}" data-lng="{{ places.chalet.lng }}">
                        {{ b.day_header('Jour 2', 'Un réveil difficile') }}

                        <p class="text-gray-700 leading-relaxed mb-6">
                            C'est sous les coups de 7h ou 8h du matin qu'on se réveille pour nous préparer à la journée qui nous attend.
                        </p>

                        {{ b.gallery([
                            {file: 'img-20v-2.jpg'},
                            {file: 'img-21v-2.jpg'},
                        ], groupe, aventure, 2, "L'attente est longue.") }}
                    </section>

                    <!-- Aiguille du Midi -->
                    <section class="mb-8" data-section="aiguille" data-lat="{{ places.aiguille.lat }}" data-lng="{{ places.aiguille.lng }}">
                        {{ b.day_header('Aiguille du Midi', 'Incertitude') }}

                        <p class="text-gray-700 leading-relaxed mb-4">
                            On avait prévu de commencer la matinée par un tour à l'aiguille du Midi.
                        </p>
                        <p class="text-gray-700 leading-relaxed mb-6">
                            Manque de chance, ce jour-là, le temps n'était pas favorable pour aller jusqu'en haut
                            car il y avait trop de vent pour les télécabines.
                        </p>

                        {{ b.callout('orange', '<strong>⚠️ Aléas météo :</strong> Les conditions en haute montagne peuvent changer rapidement. Il est important d\'avoir un plan B et de rester flexible dans ses activités.') }}

                        {{ b.gallery([
                            {file: 'img-22v-2.jpg'},
                            {file: 'img-23v-2.jpg'},
                            {file: 'img-24v-2.jpg'},
                            {file: 'img-25v-2.jpg'},
                        ], groupe, aventure, 2, "Vue depuis le refuge du Plan de l'Aiguille.") }}

                        <p class="text-gray-700 leading-relaxed mb-6">
                            On a eu le droit d'aller au premier stop, au Refuge du Plan de l'Aiguille (2 207m d'altitude),
                            où on a pu se rendre au Lac Bleu et profiter d'un petit café en terrasse.
                        </p>

                        {{ b.gallery([{file: 'img-29.jpg', aspect: true}], groupe, aventure, 1) }}

                        {{ b.gallery([
                            {file: 'img-26.jpg'},
                            {file: 'img-27.jpg'},
                            {file: 'img-28.jpg'},
                            {file: 'img-33.jpg'},
                        ], groupe, aventure, 2) }}

                        {{ b.gallery([
                            {file: 'v3.mp4', video: true},
                            {file: 'v5.mp4', video: true},
                        ], groupe, aventure, 2) }}

                        {{ b.gallery([
                            {file: 'img-30.jpg'},
                            {file: 'img-31.jpg'},
                            {file: 'img-32.jpg'},
                            {file: 'v1.mp4', video: true},
                        ], groupe, aventure, 2) }}

                        <p class="text-gray-700 leading-relaxed mb-6">
                            On redescend vers Chamonix pour prendre un autre téléphérique pour se rendre au Brevent.
                        </p>

                        {{ b.gallery([
                            {file: 'img-34.jpg'},
                            {file: 'img-35.jpg'},
                            {file: 'img-36.jpg'},
                            {file: 'img-37.jpg'},
                        ], groupe, aventure, 1) }}
                    </section>

                    <!-- Brévent -->
                    <section class="mb-8" data-section="brevent" data-lat="{{ places.brevent.lat }}" data-lng="{{ places.brevent.lng }}">
                        {{ b.day_header('Brévent', 'Une belle surprise') }}

                        <p class="text-gray-700 leading-relaxed mb-6">
                            Au sommet du Brévent, à environ 2 400m d'altitude, malgré le froid et un vent glacial, les quelques nuages et rayons de lumières nous
                            permettent de découvrir un paysage magnifique à 360° ! Chaque plan nous offre une ambiance et une histoire particulière.
                        </p>

                        {{ b.gallery([
                            {file: 'img-38.jpg'},
                            {file: 'img-39.jpg'},
                            {file: 'img-40.jpg'},
                            {file: 'img-78.jpg'},
                        ], groupe, aventure, 2, "La grandeur de la nature.") }}

                        {{ b.gallery([
                            {file: 'img-41.jpg'},
                            {file: 'img-42.jpg'},
                        ], groupe, aventure, 1) }}

                        {{ b.gallery([
                            {file: 'img-43.jpg'},
                            {file: 'img-44.jpg'},
                            {file: 'img-45.jpg'},
                            {file: 'img-46.jpg'},
                            {file: 'img-47.jpg'},
                            {file: 'img-48.jpg'},
                        ], groupe, aventure, 2) }}

                        {{ b.gallery([{file: 'img-49.jpg'}], groupe, aventure, 1, "Le vent glacial.") }}

                        <p class="text-gray-700 leading-relaxed mb-6">
                            Après avoir apprécié ce décor, on redescend à Chamonix pour se faire le petit restaurant
                            du midi, il était incroyable.
                        </p>

                        {{ b.gallery([{file: 'img-50.jpg'}], groupe, aventure, 1, "La récomposense.") }}
                    </section>

                    <!-- Mer de Glace -->
                    <section class="mb-8" data-section="merdeglace" data-lat="{{ places.merdeglace.lat }}" data-lng="{{ places.merdeglace.lng }}">
                        {{ b.day_header('Mer de glace', 'Le glacier mythique') }}

                        <p class="text-gray-700 leading-relaxed mb-6">
                            Après le restaurant, place à la digestion à bord du train à crémaillère pour découvrir le
                            glacier de la Mer de glace depuis le site du Montenvers situé à 1 913m d'altitude.
                        </p>

                        {{ b.gallery([
                            {file: 'img-51.jpg'},
                            {file: 'img-52.jpg'},
                            {file: 'img-53.jpg'},
                            {file: 'img-54.jpg'},
                        ], groupe, aventure, 2, "Le repos des guerriers.") }}

                        <p class="text-gray-700 leading-relaxed mb-6">
                            En plus de la vue sur le glacier, il est possible de visiter une grotte de glace au cœur du glacier.
                            Malheureusement, ce jour-là, la grotte était fermée à cause des conditions météorologiques.
                        </p>

                        {{ b.gallery([
                            {file: 'img-55.jpg'},
                            {file: 'img-56.jpg'},
                            {file: 'img-57.jpg'},
                            {file: 'img-58.jpg'},
                        ], groupe, aventure, 2, "Le repos des guerriers.") }}

                        {{ b.gallery([{file: 'img-59.jpg'}], groupe, aventure, 1) }}

                        <p class="text-gray-700 leading-relaxed mb-6">
                            Au retour, on décide de se reposer tranquillement au chalet et profiter du barbecue, sous la pluie !
                        </p>

                        {{ b.gallery([
                            {file: 'img-62.jpg'},
                            {file: 'img-71.jpg'},
                            {file: 'img-63.jpg'},
                            {file: 'img-79.jpg'},
                            {file: 'img-61.jpg'},
                            {file: 'img-60.jpg'},
                        ], groupe, aventure, 2, "Le repos des guerriers.") }}

                        {{ b.gallery([{file: 'v4.mp4', video: true}], groupe, aventure, 1) }}
                    </section>

                    <!-- Jour 3 -->
                    <section class="mb-8" data-section="jour3" data-lat="{{ places.chalet.lat }}" data-lng="{{ places.chalet.lng }}">
                        {{ b.day_header('Jour 3', 'Une activité sportive') }}

                        <p class="text-gray-700 leading-relaxed mb-6">
                            Pour commencer cette nouvelle journée, on avait prévu de faire un tour en rafting en mode sportif !
                            L'activité était sympathique avec en plus de beaux paysages à voir.
                        </p>

                        {{ b.gallery([{file: 'img-64.jpg'}], groupe, aventure, 1) }}

                        {{ b.gallery([
                            {file: 'img-65.jpg'},
                            {file: 'img-66.jpg'},
                            {file: 'img-67.jpg'},
                            {file: 'img-68.jpg'},
                            {file: 'img-69.jpg'},
                            {file: 'img-70.jpg'},
                        ], groupe, aventure, 2, "Une eau glaciale.") }}

                        <p class="text-gray-700 leading-relaxed mb-6">
                            Après avoir mangé, on chill au chalet avant d'aller se relaxer aux Thermes de Chamonix qui
                            offre une très belle infrastructure, une vue imprenable sur les montagnes et un apéro offert !
                        </p>

                        {{ b.gallery([
                            {file: 'img-72.jpg'},
                            {file: 'img-73.jpg'},
                            {file: 'img-74.jpg'},
                            {file: 'img-75.jpg'},
                            {file: 'img-76.jpg'},
                            {file: 'img-77.jpg'},
                        ], groupe, aventure, 2, "Détente bien méritée.") }}

                        {{ b.callout('green', "Fin de l'escapade !") }}
                    </section>
                </article>

                <!-- Carte sticky -->
                <aside class="lg:col-span-1">
                    <div class="sidebar-sticky">
                        <div class="bg-white rounded-lg p-4 shadow-sm">
                            <h3 class="font-bold text-gray-900 mb-3">📍 Parcours de l'aventure</h3>
                            <div id="map" class="map-container"></div>
                            <div class="mt-3 text-xs text-gray-600">
                                <p>La carte suit votre lecture</p>
                            </div>
                        </div>
                    </div>
                </aside>
            </div>
        </div>
    </div>

    {% include 'user/pages/blog/_map_script.html.twig' with {
        map_center: places.chalet,
        map_zoom: 18,
        map_path: map_path,
    } %}
{% endblock %}
