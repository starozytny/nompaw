{% extends 'user/pages/suggestions/template.html.twig' %}

{% set page_title %}Suggestions{% endset %}

{# Same markup as layout/components/tailwind/buttons/button.html.twig, but a <button>: the React list opens its form on click (see SuggestionsList). #}
{% set page_actions %}
    <button type="button" id="suggestion-add" class="inline-flex justify-center text-center gap-1 rounded-md py-2 px-4 text-sm font-semibold shadow-sm bg-blue-600 text-slate-50 hover:bg-blue-500 ring-1 ring-inset ring-blue-600">
        <span class="icon-add inline-block translate-y-0.5"></span>
        <span class="ml-1">Ajouter</span>
    </button>
{% endset %}

{% block main_content %}
    <div id="suggestions">
        {% include "layout/components/tailwind/loaders/loader.html.twig" %}
    </div>
{% endblock %}
