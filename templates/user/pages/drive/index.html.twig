{% extends 'user/layout/layout.html.twig' %}

{% set page_title %}Drive{% endset %}
{% set page_subtitle %}Vos fichiers personnels{% endset %}
{% set breadcrumbs = [{ text: "Drive", icon: "folder", url: path('user_drive_index') }] %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('user_drive') }}
{% endblock %}

{% block javascripts %}
